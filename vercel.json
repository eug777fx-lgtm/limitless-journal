{
  "rewrites": [
    {
      "source": "/asia",
      "destination": "/index.html"
    },
    {
      "source": "/asia/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-email",
      "schedule": "0 20 * * 6,0"
    },
    {
      "path": "/api/daily-email",
      "schedule": "0 0 * * *"
    }
  ]
}
